{
  "extends": "./tsconfig.json",
  "ts-node": {
    "esm": true,
    "preferTsExts": true,
    "transpileOnly": true
  },
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "allowJs": false,
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist"
  },
  "exclude": ["dist", "node_modules", "src/**/*.tsx", "vite.config.ts"]
}
