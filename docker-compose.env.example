POSTGRES_USER=partneriq
POSTGRES_PASSWORD=

REDIS_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
INTERNAL_OPS_KEY=
