# Copy this file to `.env` in the same directory as docker-compose.yml and fill in real
# values. Never commit the resulting .env file — it is already covered by .gitignore.
#
# DATABASE_* and REDIS_PASSWORD here must match MYSQL_DATABASE/MYSQL_USER/
# MYSQL_PASSWORD and REDIS_PASSWORD in ~/partneriq/infrastructure/.env exactly
# — this stack connects to the MySQL/Redis containers managed by that
# separate project, over the partneriq-internal network, not to anything
# started by this compose file.
#
# Generate strong random secrets with, e.g.:
#   openssl rand -hex 32

APP_URL=https://api.partneriq.in

DATABASE_NAME=partneriq
DATABASE_USER=partneriq
DATABASE_PASSWORD=

REDIS_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
INTERNAL_OPS_KEY=
