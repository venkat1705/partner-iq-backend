# Copy this file to `.env` in the same directory as docker-compose.yml and fill in real
# values. Never commit the resulting .env file — it is already covered by .gitignore.
#
# DATABASE_* and REDIS_PASSWORD here must match MYSQL_DATABASE/MYSQL_USER/
# MYSQL_PASSWORD and REDIS_PASSWORD in ~/partneriq/infrastructure/.env exactly
# — this stack connects to the MySQL/Redis containers managed by that
# separate project, over the partneriq-internal network, not to anything
# started by this compose file.
#
# Generate strong random secrets with, e.g.:
#   openssl rand -hex 32
#
# Everything below is read by docker-compose.yml. Vars with no default there
# (marked "required") must be set or `docker compose up` refuses to start.
# Vars with a default in docker-compose.yml are optional here — omit them to
# use that default, or set them to override it.

# ---- Required -----------------------------------------------------------
APP_URL=https://api.partneriq.in

DATABASE_NAME=partneriq
DATABASE_USER=partneriq
DATABASE_PASSWORD=

REDIS_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
INTERNAL_OPS_KEY=

# ---- URLs / CORS / cookies (optional — sensible prod defaults exist) ----
FRONTEND_URL=https://app.partneriq.in
AFFILIATE_FRONTEND_URL=https://affiliates.partneriq.in
CORS_ORIGINS=https://app.partneriq.in,https://affiliates.partneriq.in,https://*.partneriq.in
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=1

# ---- Rate limiting (optional) --------------------------------------------
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=100
RATE_LIMIT_TRACKING=1000

# ---- Transactional email — Brevo (optional, but emails won't send without it) --
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PartnerIQ

# ---- Billing — Razorpay (optional, but billing won't work without it) ---
PAYMENT_DEFAULT_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_STARTER_MONTHLY_PLAN_ID=
RAZORPAY_STARTER_YEARLY_PLAN_ID=
RAZORPAY_PRO_MONTHLY_PLAN_ID=
RAZORPAY_PRO_YEARLY_PLAN_ID=
RAZORPAY_BUSINESS_MONTHLY_PLAN_ID=
RAZORPAY_BUSINESS_YEARLY_PLAN_ID=
BILLING_GRACE_PERIOD_DAYS=7

# ---- File storage (required) ------------------------------------------------
# File storage (S3 / S3-compatible) — see docs/storage-setup.md and .env.example for every STORAGE_* option
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_USE_IAM_ROLE=false

# ---- Google OAuth — organization workspace login (optional) -------------
GOOGLE_OAUTH_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.partneriq.in/api/v1/auth/google/callback
GOOGLE_OAUTH_STATE_TTL_SECONDS=600

# ---- Google OAuth — affiliate portal login (optional) --------------------
GOOGLE_AFFILIATE_CLIENT_ID=
GOOGLE_AFFILIATE_CLIENT_SECRET=
GOOGLE_AFFILIATE_REDIRECT_URI=https://api.partneriq.in/api/v1/affiliate/auth/google/callback

# ---- Google Calendar — demo booking Meet links (optional) ----------------
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://api.partneriq.in/api/v1/demo-bookings/google-calendar/oauth/callback
GOOGLE_CALENDAR_ID=primary
DEMO_BOOKING_ADMIN_EMAIL=

# ---- Misc (optional) ------------------------------------------------------
GEMINI_API_KEY=
ENABLE_SWAGGER=false
FRAUD_IP_HASH_SECRET=
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d
PASSWORD_RESET_TTL=15m
EMAIL_VERIFICATION_TTL=24h
