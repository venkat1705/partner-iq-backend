PORT=5000
APP_URL=http://localhost:5000

# Fabricated demo/fixture data (admin dashboards' sample telemetry, npm run
# seed:dev, SEED_DEMO_DATA). Off by default and independent of NODE_ENV on
# purpose — never set this to true anywhere real data could end up.
ENABLE_DEV_FIXTURES=false
FRONTEND_URL=http://localhost:3000
AFFILIATE_FRONTEND_URL=http://localhost:3005
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3004,http://localhost:3005

# Google OAuth 2.0 / OpenID Connect
GOOGLE_OAUTH_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
GOOGLE_OAUTH_STATE_TTL_SECONDS=600

# Affiliate Portal Google OAuth client (separate from organization workspace OAuth)
GOOGLE_AFFILIATE_CLIENT_ID=your-affiliate-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_AFFILIATE_CLIENT_SECRET=your-affiliate-google-oauth-client-secret
GOOGLE_AFFILIATE_REDIRECT_URI=http://localhost:5000/api/v1/affiliate/auth/google/callback

# Google Calendar — creates a real Google Meet-backed calendar event for each
# demo booking. Separate from the OAuth login clients above because a login
# refresh token never carries calendar.events scope.
#
# Only the OAuth CLIENT credentials go here. The actual connection (which
# Google account's calendar to use) is made by an admin clicking "Connect
# Google Calendar" in /admin/demo-bookings — the resulting access/refresh
# tokens are stored encrypted in the database, not in this file, and are
# refreshed automatically before they expire.
#
# Setup in Google Cloud Console:
#   1. APIs & Services -> Library -> enable "Google Calendar API".
#   2. APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
#      (type: Web application).
#   3. Authorized redirect URIs -> add the exact value of
#      GOOGLE_CALENDAR_REDIRECT_URI below.
#   4. OAuth consent screen -> add the Google account that should own the
#      demo calendar as a Test user (while the app is in "Testing" status).
#   5. Copy the Client ID / Client secret into the two vars below, then go to
#      /admin/demo-bookings in the app and click "Connect Google Calendar".
#
# Note: while this OAuth client stays in Google's "Testing" publishing
# status, Google auto-expires the connection's refresh token after ~7 days
# regardless of how well the app refreshes it — reconnecting is a one-click
# fix, but moving the app to "In production" (or using an internal app on a
# Google Workspace account) avoids that entirely.
GOOGLE_CALENDAR_CLIENT_ID=your-google-calendar-oauth-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-calendar-oauth-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/v1/demo-bookings/google-calendar/oauth/callback
GOOGLE_CALENDAR_ID=primary

# Demo booking notifications
DEMO_BOOKING_ADMIN_EMAIL=info@partneriq.in

# Register this exact backend URL in HubSpot OAuth redirect URLs:
# http://localhost:5000/api/v1/integrations/hubspot/oauth/callback

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=partner_db
DATABASE_SSL=false

JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=30m
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_TTL=7d
# SUPER_ADMIN_EMAILS removed: it let anyone who could authenticate as a
# listed email (via registration, login, or Google OAuth) become SUPER_ADMIN,
# with verification gaps at several call sites. Run
# `npm run create-super-admin -- --email you@company.com` instead.

PAYMENT_DEFAULT_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=rzp_test_TOtXobIhbyZRNZ
RAZORPAY_KEY_SECRET=v7AazLfU4lbOPp3UEyCOyOHR
RAZORPAY_WEBHOOK_SECRET=7794-2409-40f2-1046-a24f-65f9-b7f2-4fa-a5e3
RAZORPAY_STARTER_MONTHLY_PLAN_ID=plan_TOtuIz57kAQBBp
RAZORPAY_STARTER_YEARLY_PLAN_ID=plan_TOtwbmJBa0N9rg
RAZORPAY_PRO_MONTHLY_PLAN_ID=plan_TOtxU6QSnZxrdv
