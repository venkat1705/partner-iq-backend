# ── File storage (src/common/storage — the ONLY place that talks to storage) ──────────────────────────────
# The backend refuses to start when a required value is missing or invalid. Setup: docs/storage-setup.md
STORAGE_PROVIDER=s3                       # only "s3" (AWS S3 or an S3-compatible service such as MinIO / R2)
STORAGE_BUCKET=                           # required: private bucket name (Block Public Access ON)
STORAGE_REGION=                           # required: e.g. ap-south-1 (MinIO: us-east-1)
STORAGE_ENDPOINT=                         # S3-compatible endpoint, e.g. http://127.0.0.1:9000 for MinIO; empty for AWS
STORAGE_FORCE_PATH_STYLE=                 # true for MinIO (default: true when STORAGE_ENDPOINT is set)
STORAGE_ACCESS_KEY_ID=                    # static keys, or leave both empty and set STORAGE_USE_IAM_ROLE=true
STORAGE_SECRET_ACCESS_KEY=                # never commit real values
STORAGE_USE_IAM_ROLE=false                # true = use the instance/task role instead of static keys
STORAGE_KEY_PREFIX=                       # optional prefix for every object key, e.g. "staging"
STORAGE_ENCRYPTION=AES256                 # AES256 (SSE-S3) | aws:kms | none
STORAGE_KMS_KEY_ID=                       # required when STORAGE_ENCRYPTION=aws:kms
STORAGE_MAX_FILE_BYTES=209715200          # per-file limit for assets and versions (200 MB)
STORAGE_MAX_IMAGE_BYTES=5242880           # per-file limit for logos, banners and avatars (5 MB)
STORAGE_ALLOWED_FILE_TYPES=               # empty = all supported: jpeg,png,gif,webp,mp4,mov,webm,pdf,doc,ppt,docx,pptx,txt,csv
STORAGE_DOWNLOAD_URL_TTL_SECONDS=300      # lifetime of signed download links (5 minutes)
STORAGE_UPLOAD_TIMEOUT_MS=1800000         # an upload stream longer than this is aborted (30 minutes)
STORAGE_REQUEST_TIMEOUT_MS=120000         # per request to the storage service
STORAGE_RETRY_MAX_ATTEMPTS=3              # retries for temporary storage errors (exponential backoff)
STORAGE_DEFAULT_ORG_LIMIT_BYTES=3221225472  # default storage per organization (3 GB); platform admins change it per org
STORAGE_MAX_CONCURRENT_UPLOADS_PER_ORG=5  # uploads one organization may run at the same time
STORAGE_RESERVATION_TTL_MINUTES=60        # reserved space of an abandoned upload is released after this
STORAGE_TRASH_RETENTION_DAYS=30           # trashed files are permanently deleted after this
STORAGE_MULTIPART_PART_BYTES=8388608      # multipart part size (memory per upload ≈ part size × queue size)
STORAGE_MULTIPART_QUEUE_SIZE=2
STORAGE_JOBS_ENABLED=true                 # run cleanup / trash purge / reconciliation jobs in this process
STORAGE_MIGRATION_ALLOWED_HOSTS=res.cloudinary.com  # hosts the legacy-file migration may copy from (npm run storage:migrate-legacy)
STORAGE_MIGRATION_ALLOW_HTTP=false        # true only in test environments

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@partneriq.local
BREVO_SENDER_NAME=PartnerIQ
